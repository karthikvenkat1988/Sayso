  "injection": {
    "method": "auto",
    "restore_clipboard": true,
    "paste_settle_ms": 150,
    "keyboard_chunk": 64,
    "app_overrides": {}
  },
  "profiles": [
    {
      "processes": [
        "OUTLOOK",
        "olk"
      ],
      "mode": "email_mode",
      "tone": "Business email."
    },
    {
      "processes": [
        "ms-teams",
        "Teams",
        "slack"
      ],
      "mode": "chat_mode",
      "tone": "Workplace chat: brief and friendly."
    },
    {
      "processes": [
        "WINWORD",
        "POWERPNT"
      ],
      "mode": "professional_mode",
      "tone": "Clear document prose."
    },
    {
      "processes": [
        "ONENOTE"
      ],
      "mode": "meeting_notes_mode",
      "tone": ""
    },
    {
      "processes": [
        "EXCEL"
      ],
      "mode": "professional_mode",
      "tone": "Short spreadsheet comment."
    },
    {
      "processes": [
        "Code",
        "devenv",
        "WindowsTerminal",
        "powershell",
        "cmd"
      ],
      "mode": "rewrite_text",
      "tone": "Technical. Keep identifiers, paths and commands verbatim."
    }
