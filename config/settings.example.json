  "privacy": {
    "history_enabled": true,
    "history_retention_days": 30,
    "share_context": true,
    "offline_only": false,
    "telemetry": false,
    "blocked_apps": [
      "KeePass",
      "KeePassXC",
      "1Password",
      "Bitwarden"
